import fs from "node:fs/promises";
import path from "node:path";
import type { BitrixRestClient } from "../../bitrix/http/client.js";

export class BitrixDiskService {
  constructor(private readonly client: BitrixRestClient) {}

  storageList() {
    return this.client.call("disk.storage.getlist", {});
  }

  folderGet(folderId: number) {
    return this.client.call("disk.folder.get", { id: folderId });
  }

  folderChildren(folderId: number) {
    return this.client.call("disk.folder.getchildren", { id: folderId });
  }

  folderCreate(parentFolderId: number, name: string) {
    return this.client.call("disk.folder.addsubfolder", { id: parentFolderId, data: { NAME: name } });
  }

  async folderUploadFile(params: { folderId: number; localPath: string; filename?: string }) {
    // Backward-compatible inline upload mode for ChatGPT actions.
    // Existing published action knows only local_path, so we allow:
    // local_path = "text://some text"
    // local_path = "base64://...."
    // local_path = "data:...;base64,...."
    if (params.localPath.startsWith("text://")) {
      const raw = params.localPath.slice("text://".length);
      const content = decodeURIComponent(raw);
      const filename = params.filename ?? "inline-text.txt";

      return this.uploadBufferToFolder({
        folderId: params.folderId,
        buffer: Buffer.from(content, "utf8"),
        filename
      });
    }

    if (params.localPath.startsWith("base64://")) {
      const raw = params.localPath.slice("base64://".length);
      const filename = params.filename ?? "inline-base64.bin";

      return this.uploadBufferToFolder({
        folderId: params.folderId,
        buffer: Buffer.from(raw, "base64"),
        filename
      });
    }

    if (params.localPath.startsWith("data:")) {
      const parts = params.localPath.split(",");
      const raw = parts.length > 1 ? parts.slice(1).join(",") : "";
      const filename = params.filename ?? "inline-data.bin";

      return this.uploadBufferToFolder({
        folderId: params.folderId,
        buffer: Buffer.from(raw, "base64"),
        filename
      });
    }

    const buf = await fs.readFile(params.localPath);
    const filename = params.filename ?? path.basename(params.localPath);
    return this.uploadBufferToFolder({
      folderId: params.folderId,
      buffer: buf,
      filename
    });
  }

  async uploadBufferToFolder(params: { folderId: number; buffer: Buffer; filename: string }) {
    return this.client.callMultipart(
      "disk.folder.uploadfile",
      {
        id: params.folderId,
        data: { NAME: params.filename }
      },
      {
        file: { buffer: params.buffer, filename: params.filename }
      }
    );
  }

  async createTextFile(params: { folderId: number; filename: string; content: string; encoding?: BufferEncoding }) {
    const buffer = Buffer.from(params.content, params.encoding ?? "utf8");
    return this.uploadBufferToFolder({
      folderId: params.folderId,
      buffer,
      filename: params.filename
    });
  }

  async uploadBase64File(params: { folderId: number; filename: string; base64Content: string }) {
    const normalized = params.base64Content.includes(",")
      ? params.base64Content.split(",").pop() ?? ""
      : params.base64Content;

    const buffer = Buffer.from(normalized, "base64");

    return this.uploadBufferToFolder({
      folderId: params.folderId,
      buffer,
      filename: params.filename
    });
  }

  fileGet(fileId: number) {
    return this.client.call("disk.file.get", { id: fileId });
  }

  fileDownloadUrl(fileId: number) {
    return this.client.call("disk.file.getDownloadUrl", { id: fileId });
  }

  move(params: { objectType: "file" | "folder"; objectId: number; targetFolderId: number }) {
    const method =
      params.objectType === "file" ? "disk.file.moveto" : "disk.folder.moveto";
    return this.client.call(method, { id: params.objectId, targetId: params.targetFolderId });
  }

  shareFolderToUser(folderId: number, userId: number, access: string = "R") {
    return this.client.call("disk.folder.sharetouser", { id: folderId, userId, access });
  }
}
