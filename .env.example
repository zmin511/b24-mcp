# App
NODE_ENV=development
LOG_LEVEL=info

# Postgres
POSTGRES_PASSWORD=b24_mcp_password
DATABASE_URL=postgresql://b24_mcp:b24_mcp_password@db:5432/b24_mcp?sslmode=disable

# Encryption (32 bytes base64). Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
APP_ENCRYPTION_KEY_BASE64=

# Bitrix connection management
# Default connection id used by tools when not provided
BITRIX_DEFAULT_CONNECTION_ID=default

# Polling/sync
JOBS_ENABLED=true
JOBS_POLL_INTERVAL_SEC=60

# MCP HTTP (when using index_http)
MCP_HTTP_ENABLED=true
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=7010
# If set, requires `Authorization: Bearer <token>` for all requests
MCP_AUTH_TOKEN=

# Optional: allow risky write tools without confirm (NOT RECOMMENDED)
ALLOW_UNCONFIRMED_WRITES=false
